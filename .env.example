# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/devflow
# Note: The application uses MySQL/TiDB, not PostgreSQL

# Authentication
JWT_SECRET=your-jwt-secret-min-32-bytes-random

# Manus OAuth (optional, for platform authentication)
OAUTH_SERVER_URL=https://api.manus.im
VITE_APP_ID=your-manus-app-id
VITE_OAUTH_PORTAL_URL=https://your-manus-portal-url
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Your Name

# GitHub OAuth (optional, for GitHub integration)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Redis (optional, for distributed BullMQ workers)
REDIS_URL=redis://localhost:6379

# Built-in AI Integration (optional)
BUILT_IN_FORGE_API_URL=https://your-forge-api-url
BUILT_IN_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://your-frontend-forge-api-url
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key

# AI Model Configuration (optional)
DEVFLOW_AI_MODEL=built-in-default
DEVFLOW_AI_DAILY_TOKEN_CAP=200000

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint
VITE_ANALYTICS_WEBSITE_ID=your-analytics-website-id
